# Copiado automaticamente por npm run setup. Nunca envie .env ao GitHub.
# Na hospedagem online, defina NODE_ENV=production.
API_PORT=4000
CLIENT_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
APP_SECRET=

# Vazio inicia PostgreSQL embarcado (PGlite), persistido em .local/database.
# Para PostgreSQL convencional, preencha a URL abaixo.
DATABASE_URL=
DATABASE_SSL=false

# console exibe o código no terminal para o teste local.
# smtp envia ao e-mail real usando os dados do seu provedor.
# Para preparar o Gmail, execute npm run setup:gmail.
MAIL_MODE=console
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=CodeSaga <noreply@exemplo.com>

# Apenas desenvolvimento. A produção sempre aplica uma hora.
LIFE_COOLDOWN_SECONDS=3600

# No GitHub Pages, informe a URL HTTPS pública da API, terminada em /api.
# Deixe vazio no desenvolvimento para usar o proxy do Vite.
VITE_API_URL=

